# Copy to .env and fill in. Never commit the filled-in file.
QT_PG_PASSWORD=
QT_DATABASE_URL=postgresql://quantterm:CHANGE_ME@127.0.0.1:5432/quantterm
QT_REDIS_URL=redis://127.0.0.1:6379/0

# >= 24 chars each, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
QT_API_TOKEN=
QT_INGEST_TOKEN=

# SEC requires a descriptive User-Agent with a contact e-mail.
QT_SEC_USER_AGENT=YourFirm research you@yourfirm.com
QT_FMP_API_KEY=
QT_POLYGON_API_KEY=
QT_KITE_API_KEY=
QT_KITE_ACCESS_TOKEN=
QT_KITE_SYMBOLS=["NSE:INFY","NSE:RELIANCE"]
